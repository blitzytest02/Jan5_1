# Dependencies
# Node.js dependencies - managed by npm/yarn, should never be committed
node_modules/

# Logs
# Various log files generated by npm, yarn, and Node.js
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Environment files
# Contains sensitive configuration (API keys, database credentials, etc.)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*.local

# Coverage
# Test coverage output generated by Jest and other testing tools
coverage/
.nyc_output/

# Build output
# Compiled/transpiled files - generated from source
dist/
build/

# OS files
# Operating system generated files
.DS_Store
Thumbs.db

# npm pack output
# Tarball files created by npm pack command
*.tgz

# Editor directories and files
# IDE-specific configuration files
.idea/
.vscode/
*.swp
*.swo
*~

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Runtime data
pids/
*.pid
*.seed
*.pid.lock
